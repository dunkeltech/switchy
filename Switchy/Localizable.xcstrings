    "Show windows from all displays/Spaces" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Fenster von allen Bildschirmen/Spaces anzeigen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar ventanas de todas las pantallas/Spaces" } },
