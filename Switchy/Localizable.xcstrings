    "Press keys…" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Taste drücken…" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pulsa una tecla…" } },
