      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausgeschlossene Apps" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Apps excluidas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Apps exclues" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "बहिष्कृत ऐप्स" } },
