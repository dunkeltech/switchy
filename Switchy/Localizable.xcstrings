    "Permissions required" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Berechtigungen erforderlich" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Permisos necesarios" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorisations requises" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अनुमतियाँ आवश्यक हैं" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Autorizzazioni necessarie" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要权限" } }
      }
    },
    "• Accessibility" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "• Bedienungshilfen (Accessibility)" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "• Accesibilidad" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "• Accessibilité" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "• एक्सेसिबिलिटी (Accessibility)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "• Accessibilità" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "• 辅助功能（Accessibility）" } }
      }
    },
    "• Screen Recording" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "• Bildschirmaufnahme (Screen Recording)" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "• Grabación de pantalla" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "• Enregistrement de l’écran" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "• स्क्रीन रिकॉर्डिंग (Screen Recording)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "• Registrazione dello schermo" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "• 屏幕录制（Screen Recording）" } }
      }
    },
    "Switchy needs the following permissions to switch windows and show previews:\n\n%@\n\nPlease enable them in System Settings and then restart the app." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Switchy benötigt folgende Berechtigungen, um Fenster wechseln und Vorschauen anzeigen zu können:\n\n%@\n\nBitte in den Systemeinstellungen aktivieren und die App anschließend neu starten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Switchy necesita los siguientes permisos para cambiar de ventana y mostrar vistas previas:\n\n%@\n\nActívalos en Ajustes del Sistema y luego reinicia la app." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Switchy a besoin des autorisations suivantes pour changer de fenêtre et afficher les aperçus :\n\n%@\n\nVeuillez les activer dans Réglages Système, puis redémarrer l’app." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "विंडो बदलने और पूर्वावलोकन दिखाने के लिए Switchy को निम्न अनुमतियों की आवश्यकता है:\n\n%@\n\nकृपया उन्हें सिस्टम सेटिंग्स में सक्षम करें और फिर ऐप को पुनः प्रारंभ करें।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Switchy necessita delle seguenti autorizzazioni per cambiare finestra e mostrare le anteprime:\n\n%@\n\nAttivale in Impostazioni di Sistema e poi riavvia l’app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Switchy 需要以下权限才能切换窗口并显示预览：\n\n%@\n\n请在“系统设置”中启用它们，然后重新启动应用。" } }
      }
    },
    "Open Accessibility" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bedienungshilfen öffnen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Accesibilidad" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir Accessibilité" } },
