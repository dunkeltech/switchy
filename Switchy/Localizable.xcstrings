    "Global switch" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Globaler Wechsel" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cambio global" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Changement global" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "ग्लोबल स्विच" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Cambio globale" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全局切换" } }
      }
    },
    "In-app switch" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "App-interner Wechsel" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cambio dentro de la app" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Changement dans l’app" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "ऐप के भीतर स्विच" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Cambio nell’app" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用内切换" } }
      }
    },
    "Reverse (during switching)" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Rückwärts (während des Wechsels)" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Atrás (durante el cambio)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retour (pendant le changement)" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "पीछे (बदलते समय)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Indietro (durante il cambio)" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "后退（切换时）" } }
      }
    },
    "Hold the modifier and tap the key; releasing confirms. To change, click the field and press the new combination. The reverse key steps the selection back one while the modifier is held (default: left ⇧)." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Modifikator halten und die Taste tippen; Loslassen bestätigt. Zum Ändern auf das Feld klicken und die neue Kombination drücken. Die Rückwärts-Taste springt bei gehaltenem Modifikator eine Auswahl zurück (Standard: linke ⇧-Taste)." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantén el modificador y pulsa la tecla; al soltar se confirma. Para cambiarlo, haz clic en el campo y pulsa la nueva combinación. La tecla de retroceso mueve la selección un paso atrás mientras se mantiene el modificador (predeterminado: ⇧ izquierdo)." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Maintenez le modificateur et appuyez sur la touche ; relâcher valide. Pour modifier, cliquez sur le champ et appuyez sur la nouvelle combinaison. La touche de retour recule la sélection d’un cran tant que le modificateur est maintenu (par défaut : ⇧ gauche)." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मॉडिफ़ायर दबाए रखें और कुंजी टैप करें; छोड़ने पर पुष्टि होती है। बदलने के लिए फ़ील्ड पर क्लिक करें और नया संयोजन दबाएँ। मॉडिफ़ायर दबाए रखने पर रिवर्स कुंजी चयन को एक कदम पीछे ले जाती है (डिफ़ॉल्ट: बायाँ ⇧)।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni premuto il modificatore e premi il tasto; il rilascio conferma. Per modificare, fai clic sul campo e premi la nuova combinazione. Il tasto Indietro sposta la selezione indietro di uno mentre il modificatore è premuto (predefinito: ⇧ sinistro)." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按住修饰键并轻点按键；松开即确认。若要更改，点按该字段并按下新的组合键。按住修饰键时，后退键将所选项向后移动一位（默认：左 ⇧）。" } }
      }
    },
    "Window Behavior" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Fenster-Verhalten" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comportamiento de ventanas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Comportement des fenêtres" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "विंडो व्यवहार" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Comportamento delle finestre" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "窗口行为" } }
      }
    },
    "Include minimized windows" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Minimierte Fenster einbeziehen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Incluir ventanas minimizadas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Inclure les fenêtres réduites" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मिनिमाइज़ की गई विंडो शामिल करें" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Includi le finestre ridotte a icona" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "包含已最小化的窗口" } }
      }
