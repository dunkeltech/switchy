        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Quitter" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद करें" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Esci" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "退出" } }
