        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已排除的应用" } }
      }
    },
    "Windows of these apps never appear in the switcher." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Fenster dieser Apps erscheinen nie im Umschalter." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las ventanas de estas apps nunca aparecen en el conmutador." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les fenêtres de ces apps n’apparaissent jamais dans le sélecteur." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "इन ऐप्स की विंडो स्विचर में कभी दिखाई नहीं देतीं।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Le finestre di queste app non compaiono mai nello switcher." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些应用的窗口永远不会出现在切换器中。" } }
      }
    },
    "No apps excluded" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Apps ausgeschlossen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ninguna app excluida" } },
